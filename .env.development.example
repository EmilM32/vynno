# Vite (`npm run dev`) and Playwright. Copy to .env.development.
# Do not put ORIGIN / HOST / PORT here — those are production-only
# (.env.production). Keys here must not also appear in .env.

# Playground API (vynno-api scripts/dev). Daily Node uses .env.production.
# Escape hatch (no file edit): API_ORIGIN=http://localhost:27182 npm run dev
API_ORIGIN=http://localhost:8081
