# Shared by Vite, production Node, and Playwright. Mode-specific keys live in
# .env.development / .env.production — do not put API_ORIGIN, ORIGIN, HOST, or
# PORT here. Copy: .env.example → .env, plus the two mode examples.

# Browser / SSR API prefix. `/v1` = same-origin BFF (Kit proxies to API_ORIGIN).
# Use an absolute https://…/v1 only when the API shares the session cookie with the SPA.
PUBLIC_API_BASE=/v1

# Playwright preview origin. Required for npm run test:e2e.
E2E_ORIGIN=http://localhost:4173

# Optional. Direct vynno-api /v1 for e2e setup. Defaults to ${API_ORIGIN}/v1
# from .env.development (playground :8081). Uncomment to override.
# E2E_API_BASE=http://localhost:8081/v1

# Optional. Playwright e2e registers throwaway users by default.
# Set these only if you want a spec to sign in as the bootstrap account.
# E2E_EMAIL=alexdev@vynno.local
# E2E_PASSWORD=local-dev-password

# Avatar PUT is 1 MiB and goes through the /v1 BFF (adapter-node default is 512K).
BODY_SIZE_LIMIT=2M
