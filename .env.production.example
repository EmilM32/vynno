# Local production (`scripts/start`, `npm run start`). Copy to .env.production.
# Keys here must not also appear in .env. Vite does not load this file.

# Daily API bind is 127.0.0.1:27182. The BFF talks to localhost, not vynno.local.
# scripts/start refuses playground :8081 — that belongs in .env.development.
API_ORIGIN=http://localhost:27182

# Bookmark https://vynno.local (Caddy :443, HTTP :80 redirects). Node itself
# is 127.0.0.1:27180 — that port is uncommon on purpose and is not a browser
# origin. List ORIGIN in vynno-api SPA_ORIGIN. npm run start is Node only
# (no :80/:443 proxy). After first start: scripts/trust-caddy (once).
ORIGIN=https://vynno.local
HOST=127.0.0.1
PORT=27180
