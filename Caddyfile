{
	admin 127.0.0.1:27179
	auto_https disable_redirects
	local_certs
	skip_install_trust
	# :80 is the HTTP redirect. Pin h1 so Caddy does not WARN "HTTP/2 skipped because it requires TLS".
	# *.localhost dual-stacks (RFC 6761); bind both loopbacks, never the LAN.
	servers 127.0.0.1:80 {
		protocols h1
	}
	servers [::1]:80 {
		protocols h1
	}
	servers 127.0.0.1:443 {
		protocols h1 h2 h3
	}
	servers [::1]:443 {
		protocols h1 h2 h3
	}
}

http://vynno.localhost {
	bind 127.0.0.1 [::1]
	log {
		output file {$CADDY_LOG:/tmp/vynno-caddy.log} {
			roll_size 1MiB
			roll_keep 7
		}
		format json
	}
	redir https://{host}{uri} 308
}

https://vynno.localhost {
	bind 127.0.0.1 [::1]
	tls internal
	log {
		output file {$CADDY_LOG:/tmp/vynno-caddy.log} {
			roll_size 1MiB
			roll_keep 7
		}
		format json
	}
	# adapter-node serves /_app/immutable/* through sirv, which never reaches
	# src/hooks.server.ts, so Node stamps these on documents but not on assets. Setting them
	# here covers both (Caddy replaces the identical value Node already sent).
	# The CSP is deliberately NOT here: it is per-render and nonce-bearing (kit.csp), and a
	# blanket edge CSP would break src/error.html's inline script and style. See ADR-0025.
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	reverse_proxy 127.0.0.1:{$PORT:27180} {
		header_up X-Request-ID {http.request.uuid}
		header_down X-Request-ID {http.request.uuid}
	}
}
