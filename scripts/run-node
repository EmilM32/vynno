#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

# Adapter-node only (no Caddy). Daily URL is scripts/start → http://vynno.local.

load_env
require_var HOST
require_var PORT
require_var ORIGIN
require_var BODY_SIZE_LIMIT
require_var API_ORIGIN
require_build

export NODE_ENV=production
exec node "$ROOT/build"
