#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat <<'EOF'
Start the production Node server and the loopback :80/:443 proxy (does not build).

  scripts/start           run in the foreground (mirrors logs/spa.log)
  scripts/start --detach  background; pid in var/spa.pid, logs in logs/spa.log

Run scripts/build first when the output is missing or stale.
EOF
}

DETACH=0
for arg in "$@"; do
	case "$arg" in
	--detach | -d) DETACH=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown argument: $arg"
		;;
	esac
done

load_env
require_var HOST
require_var PORT
require_var ORIGIN
require_var BODY_SIZE_LIMIT
require_var API_ORIGIN
require_build
require_api

if pid="$(spa_pid)"; then
	if [[ "$DETACH" -eq 1 ]]; then
		mkdir -p "$ROOT/var"
		echo "$pid" >"$PIDFILE"
		wait_for_spa "$pid"
		start_proxy
		echo "already running pid $pid"
		exit 0
	fi
	die "already running (pid $pid); scripts/stop first"
fi

export NODE_ENV=production
export HOST PORT ORIGIN BODY_SIZE_LIMIT API_ORIGIN
export LOG_FORMAT=json

mkdir -p "$ROOT/logs" "$ROOT/var"
rotate_log "$SPA_LOG"

# Node first so Caddy does not 502 on the first request.
if [[ "$DETACH" -eq 1 ]]; then
	nohup node "$ROOT/build" >>"$SPA_LOG" 2>&1 &
	pid=$!
	echo "$pid" >"$PIDFILE"
	wait_for_spa "$pid"
	start_proxy
	echo "started pid $pid  log $SPA_LOG  ${ORIGIN}"
	exit 0
fi

start_proxy
trap stop_proxy EXIT
node "$ROOT/build" 2>&1 | tee -a "$SPA_LOG"
