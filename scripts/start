#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() {
	cat <<'EOF'
Start the production Node server and the loopback :80 proxy (does not build).

  scripts/start           run in the foreground
  scripts/start --detach  background; pid in var/spa.pid, logs in logs/spa.log

Run scripts/build first when the output is missing or stale.
EOF
}

DETACH=0
for arg in "$@"; do
	case "$arg" in
	--detach | -d) DETACH=1 ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		die "unknown argument: $arg"
		;;
	esac
done

load_env
require_var HOST
require_var PORT
require_var ORIGIN
require_var BODY_SIZE_LIMIT
require_var API_ORIGIN
require_build
require_api

if pid="$(spa_pid)"; then
	die "already running (pid $pid); scripts/stop first"
fi

export NODE_ENV=production
export HOST PORT ORIGIN BODY_SIZE_LIMIT

start_proxy

if [[ "$DETACH" -eq 1 ]]; then
	mkdir -p "$ROOT/logs" "$ROOT/var"
	nohup node --env-file="$ROOT/.env" "$ROOT/build" >>"$ROOT/logs/spa.log" 2>&1 &
	echo $! >"$PIDFILE"
	echo "started pid $!  log $ROOT/logs/spa.log  ${ORIGIN}"
	exit 0
fi

trap stop_proxy EXIT
node --env-file="$ROOT/.env" "$ROOT/build"
